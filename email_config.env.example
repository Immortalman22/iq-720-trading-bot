# Email configuration for the IQ-720 Trading Bot
# Replace with your actual email credentials

# SMTP settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
# For Gmail, use an App Password instead of your regular password
# https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=your-app-password-here

# Email recipients (comma-separated list)
EMAIL_RECIPIENTS=["aurevian22@gmail.com", "galdiale@gmail.com"]

# Daily report time (24-hour format, South Africa Time)
DAILY_REPORT_TIME=06:00
